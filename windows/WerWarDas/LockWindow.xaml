<Window x:Class="WerWarDas.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WerWarDas – gesperrt"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        WindowStartupLocation="Manual" Background="#FF12161C" Foreground="White"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="BigButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="28,14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="#FF2EA05A" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF36B868" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#FF4A5560" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="920" Margin="32" VerticalAlignment="Center">
                <TextBlock Text="🧹 Räum endlich dein Zimmer auf!" FontSize="46" FontWeight="Bold"
                           TextWrapping="Wrap" TextAlignment="Center" />
                <TextBlock x:Name="ReasonText" FontSize="22" Foreground="#FFD8DEE6" Margin="0,18,0,0"
                           TextWrapping="Wrap" TextAlignment="Center" />
                <TextBlock x:Name="ScoreText" FontSize="18" Foreground="#FFFFC857" Margin="0,10,0,0"
                           TextAlignment="Center" />

                <Border CornerRadius="10" Margin="0,22,0,0" HorizontalAlignment="Center" ClipToBounds="True"
                        BorderBrush="#33FFFFFF" BorderThickness="1">
                    <Image x:Name="Photo" MaxHeight="380" Stretch="Uniform" />
                </Border>

                <Button x:Name="CheckButton" Style="{StaticResource BigButton}" Margin="0,26,0,0"
                        HorizontalAlignment="Center" Click="CheckButton_Click"
                        Content="✔ Ich habe aufgeräumt – jetzt prüfen" />
                <TextBlock x:Name="StatusText" FontSize="16" Foreground="#FFAAB4C0" Margin="0,14,0,0"
                           TextWrapping="Wrap" TextAlignment="Center" />

                <StackPanel x:Name="PinPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,34,0,0">
                    <TextBlock Text="Notfall-PIN:" FontSize="14" Foreground="#FF8894A0" VerticalAlignment="Center" />
                    <PasswordBox x:Name="PinBox" Width="140" Margin="10,0" FontSize="14" Padding="4"
                                 KeyDown="PinBox_KeyDown" />
                    <Button Content="Entsperren" Padding="12,4" FontSize="14" Click="PinButton_Click" />
                    <TextBlock x:Name="PinError" FontSize="14" Foreground="#FFFF6B6B" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
