<Window x:Class="WerWarDas.NoticeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WerWarDas – Zimmer aufräumen!"
        Width="440" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent" FontFamily="Segoe UI">
    <Border Background="#FF1E252E" CornerRadius="12" BorderBrush="#FFFFC857" BorderThickness="2" Padding="18">
        <StackPanel>
            <TextBlock Text="🧹 Räum bitte dein Zimmer auf!" Foreground="White" FontSize="22" FontWeight="Bold"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="ReasonText" Foreground="#FFD8DEE6" FontSize="15" Margin="0,8,0,0" TextWrapping="Wrap" />
            <Border CornerRadius="8" Margin="0,12,0,0" ClipToBounds="True">
                <Image x:Name="Photo" MaxHeight="220" Stretch="Uniform" />
            </Border>
            <TextBlock x:Name="DeadlineText" Foreground="#FFFFC857" FontSize="15" FontWeight="SemiBold"
                       Margin="0,12,0,0" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CheckButton" Content="Aufgeräumt – jetzt prüfen" Padding="14,6" Margin="0,0,10,0"
                        Click="CheckButton_Click" />
                <Button Content="OK" Padding="20,6" Click="OkButton_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
